 case 'v4.resume':if(props_().getProperty('RM4_CLEANUP_ENABLED')!=='true')throw new Error('Pulizia non abilitata: completare il collaudo e aggiornare tutte le distribuzioni Apps Script attive.');if(d.confirm!=='RIMUOVI')throw new Error('Confermare la ripresa.');return withLock_(()=>{const u=v4Unit_(d.key);if(u.state!=='ARCHIVING')throw new Error('Nessuna rimozione da riprendere.');const body={key:u.key,exportId:u.exportId,digest:u.digest,fileId:u.fileId,fileHash:u.fileHash};return {status:'success',...v4Clean_({...body,ticket:sign_('archive-verify|'+v4Canonical_(body))})};});
 case 'v4.clean':if(props_().getProperty('RM4_CLEANUP_ENABLED')!=='true')throw new Error('Pulizia non abilitata: completare il collaudo e aggiornare tutte le distribuzioni Apps Script attive.');if(d.confirm!=='RIMUOVI')throw new Error('Conferma esplicita della rimozione richiesta.');return withLock_(()=>({status:'success',...v4Clean_(d)}));
 default:throw new Error('Operazione versione 4 non prevista.');
 }
}

function v4RowsMatching_(sheet,column,value,width){if(sheet.getLastRow()<2)return [];const range=sheet.getRange(2,column,sheet.getLastRow()-1,1);if(range.createTextFinder)return range.createTextFinder(String(value)).matchEntireCell(true).findAll().map(r=>sheet.getRange(r.getRow(),1,1,width).getValues()[0]);return weeklyRows_(sheet,width).filter(r=>String(r[column-1])===String(value));}
function v4Previous_(events,requestId){return v4RowsMatching_(events,17,requestId,18).map(r=>JSON.parse(r[17]));}
function v4ArchivedShift_(id){const sheet=v4Tables_().ss.getSheetByName('RM4_QR');return sheet&&v4RowsMatching_(sheet,1,id,2).length>0;}

function v4RollMap_(){return new Map(weeklyRows_(v4Tables_().roll,3).map(r=>[r[0],r[1]]));}
